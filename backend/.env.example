# AgentFlow Backend Environment Variables

# Project & Security
PROJECT_NAME=AgentFlow
SECRET_KEY=generate_a_secure_32_byte_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite fallback: sqlite:///./agentflow.db
# Production PostgreSQL: postgresql://postgres:postgres@localhost:5432/agentflow
DATABASE_URL=sqlite:///./agentflow.db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# AI Model Providers
# Obtain Groq API Key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
# Obtain Google Gemini Key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_AI_PROVIDER=groq
DEFAULT_MODEL_NAME=llama-3.3-70b-versatile

# AWS & Cloud Storage (Optional / Production)
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=agentflow-reports-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

